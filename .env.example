# ============================================================
# JIJP Monorepo — Environment Variables
# Copy to .env and fill in values. Never commit .env!
# ============================================================

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=jijp_db
DB_USER=jijp_user
DB_PASSWORD=changeme

# --- Backend (apps/api) ---
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001

# Session secret (generate: openssl rand -hex 32)
SESSION_SECRET=changeme_generate_strong_secret

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173

# --- Frontend (apps/web) ---
VITE_API_URL=http://localhost:3001

# --- Email (SMTP) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# --- File Storage ---
# Local (default): leave STORAGE_DRIVER empty or "local"
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads

# S3/MinIO (future):
# STORAGE_DRIVER=s3
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=ap-southeast-1

# --- Webhook (optional) ---
WEBHOOK_SECRET=changeme_webhook_secret

# --- SSO (optional, for enterprise SSO integration) ---
# SSO_PROVIDER_URL=
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=
# SSO_JWT_PUBLIC_KEY=

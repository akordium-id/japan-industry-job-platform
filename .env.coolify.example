# ============================================================
# JIJP Production Environment Template untuk Coolify
# Salin variabel ini ke menu "Environment Variables" di Coolify.
# ============================================================

# --- Aplikasi & Keamanan ---
NODE_ENV=production
SESSION_SECRET=ganti_dengan_random_hex_minimal_32_karakter_openssl_rand_hex_32
CORS_ORIGINS=

# --- Port Host Binding (Opsional / Defaults) ---
# Default port 80 untuk web frontend di Coolify (atau diatur oleh Traefik Coolify)
PORT_WEB=80
# DB_PORT_BIND=127.0.0.1:3306
# API_PORT_BIND=127.0.0.1:3001

# --- Database MySQL ---
# Jika menggunakan MySQL container internal dalam stack (default):
DB_HOST=mysql
DB_PORT=3306
DB_NAME=jijp_db
DB_USER=jijp_user
DB_PASSWORD=buat_password_db_yang_kuat
DB_ROOT_PASSWORD=buat_root_password_db_yang_kuat

# Jika menggunakan Managed Database MySQL terpisah dari Coolify:
# Ganti DB_HOST dengan IP privat / hostname service MySQL Coolify
# DB_HOST=10.0.0.x
# DB_PORT=3306

# --- Frontend Build Arg (Opsi A: Kosongkan agar relative /api) ---
VITE_API_URL=

# --- File Storage & Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# --- Email (SMTP) - Opsional ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=JIJP <noreply@jijp.id>

# --- Webhook & SSO - Opsional ---
WEBHOOK_URL=
WEBHOOK_SECRET=
SSO_PROVIDER_URL=
SSO_JWT_PUBLIC_KEY=

NODE_ENV=development
PORT=3001

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=jijp_db
DB_USER=jijp_user
DB_PASSWORD=changeme

# Session
SESSION_SECRET=changeme_generate_strong_secret

# CORS
CORS_ORIGINS=http://localhost:5173

# File storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=JIJP <noreply@jijp.id>

# Webhook (optional)
WEBHOOK_URL=
WEBHOOK_SECRET=

# SSO (optional, generic provider)
SSO_PROVIDER_URL=
SSO_JWT_PUBLIC_KEY=

# Rate limits (optional overrides)
RATE_LIMIT_GLOBAL_PER_MIN=100
RATE_LIMIT_AUTH_PER_MIN=15
RATE_LIMIT_UPLOAD_PER_15MIN=20
RATE_LIMIT_CV_PER_MIN=10